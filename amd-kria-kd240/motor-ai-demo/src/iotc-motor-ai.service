[Unit]
Description=IOTCONNECT KD240 Motor AI Demo
Wants=network-online.target
After=network-online.target dfx-mgr.service

[Service]
Type=simple
WorkingDirectory=/opt/demo
ExecStartPre=/bin/bash /opt/demo/motor-firmware-load.sh
Environment=LD_LIBRARY_PATH=/opt/xilinx/xlnx-app-kd240-foc-motor-ctrl/lib
Environment=PYTHONPATH=/opt/xilinx/xlnx-app-kd240-foc-motor-ctrl/lib
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/demo/app.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
