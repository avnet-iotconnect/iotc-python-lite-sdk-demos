* text=auto

# Ensure Unix line endings for executable scripts used on target boards.
*.sh text eol=lf
*.bash text eol=lf

# Keep Python and config files LF as well to avoid shell/tooling edge cases.
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Hide Verilog files from stats
*.v linguist-detectable=false
*.vh linguist-detectable=false
*.sv linguist-detectable=false
*.svh linguist-detectable=false

# Ensure Python is detected
*.py linguist-detectable=true
